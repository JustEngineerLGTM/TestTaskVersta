@model TestTaskVersta.Models.Entities.Order

<h3>Создать заказ</h3>
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}
<form asp-action="Create" asp-controller="Home" method="post">

    <div class="mb-3">
        <label asp-for="SenderCity">Город отправителя</label>
        <input asp-for="SenderCity" class="form-control"/>
        <span asp-validation-for="SenderCity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="SenderAddress"></label>
        <input asp-for="SenderAddress" class="form-control"/>
        <span asp-validation-for="SenderAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReceiverCity"></label>
        <input asp-for="ReceiverCity" class="form-control"/>
        <span asp-validation-for="ReceiverCity" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReceiverAddress"></label>
        <input asp-for="ReceiverAddress" class="form-control"/>
        <span asp-validation-for="ReceiverAddress" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Weight"></label>
        <input asp-for="Weight" class="form-control"/>
        <span asp-validation-for="Weight" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PickupDate"></label>
        <input asp-for="PickupDate" type="date" class="form-control"/>
        <span asp-validation-for="PickupDate" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Создать</button>

</form>